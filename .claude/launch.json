{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "listing-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "edge/scripts/preview-listing.mjs"
      ],
      "port": 8788
    },
    {
      "name": "aem-up",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "@adobe/aem-cli",
        "up",
        "--no-open"
      ],
      "port": 3000
    },
    {
      "name": "aem-up-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "@adobe/aem-cli",
        "up",
        "--no-livereload",
        "--no-open",
        "--port",
        "3001",
        "--html-folder",
        ".local-preview",
        "--html-mount",
        "/"
      ],
      "port": 3001
    }
  ]
}
