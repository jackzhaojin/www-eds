# Copy to hlx-config/.env for a temporary token (git-ignored). Nothing here is required:
# sheets.mjs and the EXECUTION.md commands fall back to the da-auth token cache
# (~/.aem/da-token.json), an Adobe IMS token the Admin API accepts as a bearer.
BASE_URL=https://admin.hlx.page
ORG=jackzhaojin
SITE=www-eds
REF=main
# An IMS access token (Authorization: Bearer) or an admin.hlx.page auth_token (X-Auth-Token).
DA_TOKEN=
