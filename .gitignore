.hlx/*
coverage/*
logs/*
node_modules/*

helix-importer-ui
.DS_Store
*.bak
.idea

# Ensure these files are tracked
!CLAUDE.md
!AGENTS.md

# >>> stardust
.env
.env.*
# <<< stardust
# templates without secrets stay tracked
!.env.example

# playwright temp output
.playwright-cli/
.playwright-mcp/

# agent worktrees
.claude/worktrees/
.impeccable/hook.cache.json
.impeccable/config.local.json
stardust/rollout/lighthouse/

# content/: DA is the source of truth (content/README.md). Only the example pages are tracked, and
# tracked files stay tracked; a page pulled from DA or written for it stays local. Add a new
# example on purpose: git add -f content/<path>.
content/**
!content/README.md

# local previews of content/ pages (stardust/scripts/deploy/local-preview.mjs)
.local-preview/
